{
  "name": "contractor-licensing-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:frontend": "next build src/frontend",
    "dev:frontend": "next dev src/frontend -p 3000",
    "migrate:local": "wrangler d1 migrations apply contractor_licensing --local",
    "migrate:remote": "wrangler d1 migrations apply contractor_licensing --remote",
    "seed": "tsx scripts/seed-rules.ts",
    "seed:user": "tsx scripts/seed-user.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "stripe": "^17.0.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0"
  }
}
